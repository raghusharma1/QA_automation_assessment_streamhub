# Copy to `.env` (git-ignored) and fill in values. Only secrets belong here;
# per-environment settings live in env/<TEST_ENV>.env. Any key below can also
# override env/<TEST_ENV>.env values locally (e.g. HEADLESS=false).

# Optional: used only with HEAL_LLM=anthropic (the Anthropic API adapter of the self-healing
# POC in self-heal/). By default the healer replays recorded responses (self-heal/cassettes/)
# or, when none exists, asks headless Claude Code with your existing login. See SELF_HEALING.md.
ANTHROPIC_API_KEY=
# HEAL_MODEL=claude-sonnet-5-5

# Optional local overrides
# HEADLESS=false
# WORKERS=1
# WORKERS=50%
# Not here: TEST_ENV (it selects the env file, so set it in the shell, e.g. `npm run test:ci`).
